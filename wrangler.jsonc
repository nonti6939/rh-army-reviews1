{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rh-army-reviews",
  "main": "worker.js",
  "compatibility_date": "2026-09-20",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rh-army-reviews-db",
      "database_id": "REPLACE_WITH_YOUR_DATABASE_ID"
    }
  ]
}
