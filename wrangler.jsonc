{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rh-army-reviews1",
  "main": "worker.js",
  "compatibility_date": "2026-09-20",
  "vars": {
    "ADMIN_PASSWORD": "CHANGE-THIS-TO-A-LONG-PASSWORD"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rh-army-reviews-db",
      "database_id": "dcd34ad9-1fe7-4965-808e-315b0d0c0a14"
    }
  ]
}
